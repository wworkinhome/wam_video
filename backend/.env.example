DATABASE_URL="postgresql://user:password@localhost:5432/wamvideo?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/wamvideo?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"
# Orígenes permitidos para CORS (coma-separados si son varios). El frontend Next.js corre en :3005 en dev.
FRONTEND_URL="http://localhost:3005"

# Wompi (pasarela de pago colombiana) — crear una cuenta de comercio (sandbox es gratis)
# en https://comercios.wompi.co para obtener estas llaves. Los planes que se cobren por
# Wompi deben estar en COP.
WOMPI_ENV="sandbox"
WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_PRIVATE_KEY="prv_test_..."
WOMPI_INTEGRITY_SECRET="test_integrity_..."
WOMPI_EVENTS_SECRET="test_events_..."
